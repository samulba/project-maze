# Project Maze – Produktions-ENV. Kopieren nach .env und anpassen.
# Alle Werte haben sichere Voreinstellungen; nur MAZE_WS_URL und ALLOWED_ORIGIN
# müssen für eine echte Domain gesetzt werden.

# ── Edge (docker compose) ────────────────────────────────────────────────────
# Host-Port, unter dem nginx den Client ausliefert.
MAZE_HTTP_PORT=8080
# WebSocket-Adresse, die in das Client-Bundle gebacken wird (Build-Zeit!).
# Hinter TLS: wss://maze.example.com/ws
MAZE_WS_URL=ws://localhost:8080/ws
# Image-Tag für beide Services.
MAZE_TAG=local

# ── Spielserver ──────────────────────────────────────────────────────────────
# TCP-Port im Container (1–65535).
PORT=2567
# Anzahl der Bots in der Arena (0–18).
BOT_COUNT=8
# Arena-Direktor: hält die Bot-Population passend zur Zahl der Menschen
# (1 Mensch → 8 Bots, je weiterem Menschen −1, Minimum 3; höchstens eine
# Änderung alle 5 s). BOT_COUNT ist dann nur noch die Startbesetzung.
# Auf "false" bleibt die Population starr bei BOT_COUNT.
ARENA_DIRECTOR_ENABLED=true
# Modus dieser Arena: maze (Standard), ffa oder royale.
#   maze   – Wände in Bahnen, Deckung, Ecken.
#   ffa    – offene Arena ohne Wände; Reichweite und Tempo statt Deckung.
#   royale – schrumpfende Zone, wer stirbt ist bis zur nächsten Runde raus.
# EINE Arena je Prozess: Wer zwei Modi gleichzeitig anbieten will, startet zwei
# Dienste. Ein unbekannter Wert startet als "maze" und schreibt eine Warnung.
ARENA_MODE=maze
# Nur für royale: Zeitraffer der Zone. 1 = Normaltempo (erste Verengung nach
# 40 s, Endphase nach rund zehn Minuten), 20 = erste Verengung nach zwei
# Sekunden. Zum Ansehen und Abstimmen des Modus, nicht für den Betrieb.
ROYALE_SPEED=1
# Erlaubte Browser-Origins, kommagetrennt. In Produktion nie "*" lassen.
ALLOWED_ORIGIN=https://maze.example.com
# F2-Debug-Werkzeuge. In Produktion zwingend false.
ENABLE_DEV_TOOLS=false
# Vorlauf beim Herunterfahren (ms), in dem /health schon 503 meldet. 0 = sofort
# schließen (richtig für Railway); hinter eigenem Loadbalancer 500–2000.
SHUTDOWN_DRAIN_MS=0
# Lässt unveränderte Felder (Name, Klasse, Upgrades, Wände, Bestenliste,
# Killfeed, Formstatik) aus dem Snapshot weg – rund 40 % weniger Bytes.
# Braucht einen Client, der den letzten Stand puffert – DER IST AUSGELIEFERT
# (snapshot-hydrator.ts), im echten Browser gegengeprueft. In Railway ist der
# Schalter an; der Standard hier steht nur aus Vorsicht auf false. Das Runden der Zahlen läuft unabhängig davon.
SNAPSHOT_DELTAS=false
# Serverseitige Achievement-Engine (rein beobachtend). Der Client zeigt
# Freischaltungen als Popup, die Profilkarte listet sie. Dauerhaft gespeichert
# wird nur mit Supabase-Persistenz + AUTH_ENABLED und eingeloggtem Konto; für
# Gäste gilt der Fortschritt je Verbindung.
# Seit 12.08. OPT-OUT: Vorher war es Opt-in, und niemand hat es je gesetzt --
# in Produktion lief das Erfolgssystem nie. `false` stellt den Stand davor her.
ACHIEVEMENTS_ENABLED=true
# Ersetzt die UUIDs im Snapshot durch fortlaufende Zahlen (~16 % weniger Bytes
# zusätzlich zu SNAPSHOT_DELTAS). Setzt einen Client voraus, der Zahlen statt
# Strings als Entitäts-ID akzeptiert – und der seine eigene ID aus
# snapshot.selfId nimmt, nicht aus der welcome-Nachricht: die trägt weiterhin
# die UUID. Beides erfuellt der ausgelieferte Client – im Browser gegengeprueft,
# und in Railway ist der Schalter an. Wer ein EIGENES Werkzeug gegen den Server
# baut, muss es aber selbst beachten: Wer die ID aus welcome behaelt, findet
# sich nie im Snapshot und bleibt unbemerkt auf Level 1.
SHORT_NET_IDS=false
# Nach dem Tod live dem eigenen Killer zusehen. Der Snapshot wird dann aus
# dessen Perspektive gebaut (selfId bleibt die eigene). Braucht einen Client,
# der die Kamera auf spectatorTargetId zentriert – DER IST AUSGELIEFERT
# (spectator.ts, renderer.ts). In Railway ist der Schalter an.
SPECTATOR_ENABLED=false
# Alle Signature-Schalter sind in /health unter "features" ablesbar – wer
# beurteilen soll, was eine Signature im Spiel anrichtet, prueft dort zuerst,
# ob sie ueberhaupt an ist. Nur der exakte Wert "true" schaltet ein.
#
# Klassen 3.0, Signature der RAPID-Familie (Momentum): Wer in Bewegung feuert,
# lädt einen Balken auf und feuert schneller; im Stand fällt er. Ohne den
# Schalter wird die Schicht nicht angehängt und die Nachladezeiten sind die
# alten. Braucht einen Client, der den Momentum-Balken zeigt.
SIGNATURE_RAPID_ENABLED=false
# Klassen 3.0, Signature der IMPACT-Familie (Wucht): Anlauf in Fahrt erhöht den
# Körperschaden und wird beim Aufprall verbraucht. Der Anteilsdeckel begrenzt
# einen Kontakttick auf 8 % des Maximallebens des Opfers.
SIGNATURE_IMPACT_ENABLED=false
# Klassen 3.0, Signature der PRECISION-Familie (Ladeschuss): Halten laedt,
# Loslassen schiesst, ein Sofortklick traegt nur 45 % Schaden. Bei voller Ladung
# loest der Schuss selbst aus – sonst wuerde der Dauerfeuer-Schalter des Clients
# nie ausloesen. Der Schaden steigt dabei NIE ueber den heutigen Wert: Ein
# Lancer traegt schon jetzt 86 % des Lebens des duennsten Gegners seiner Stufe.
# Der volle Ausschlag kauft Groesse und Durchschlag, nicht Schaden.
SIGNATURE_PRECISION_ENABLED=false
# Klassen 3.0, Signature der CONTROL-Familie (Einheiten-Budget): Der Zeitgeber,
# der verlorene Drohnen ersetzt, wird durch ein Nachschub-Konto abgeloest.
# Volles Budget = eine komplette Flotte, die Nachfuellrate entspricht im Mittel
# genau dem heutigen Wiederaufbau. Wer eine Weile nichts verliert, stellt eine
# ausgeloeschte Flotte sofort wieder hin; wer zweimal kurz hintereinander
# verliert, steht ohne Nachschub da. Deployables (Mini-Turm, Feld) sind noch
# nicht dabei – sie brauchen eine Aenderung an der Snapshot-Form.
SIGNATURE_CONTROL_ENABLED=false
# Klassen 3.0/KL4, Familien-Upgrades: schaltet die beiden Upgrade-Slots
# signatureRate und signaturePower frei (Tasten 9 und 0). ACHTUNG, das ist
# keine reine Ergänzung: Mit dem Schalter wandert die Signature-Stärke aus dem
# Festwert in die Punkte-Ökonomie – wer nichts investiert, hat eine deutlich
# schwächere Signature als ohne den Schalter (Rapid 0,08 statt 0,25).
# Kaufbar sind die Slots nur für Familien, deren Signature läuft: ohne
# SIGNATURE_RAPID_ENABLED bzw. SIGNATURE_IMPACT_ENABLED bleiben sie gesperrt,
# und ohne Familie (Core) sowieso. Welche Familien offen sind, steht in
# /health unter features.familyUpgradeBranches.
FAMILY_UPGRADES_ENABLED=false
# Projektiltempo 2.0. Drei Regeln statt eines Daempfers: Grundtempo x0,70 fuer
# alle Zweige (Precision verliert die Sonderbehandlung), ein mit dem Level
# fallender Deckel (2,6x -> 1,8x Spielertempo) und ein Boden, unter den keine
# Kugel faellt. Das Tempo-Upgrade steigt um 2,5 % je Punkt statt um 4 % und
# rechnet nach dem Deckel. Die Reichweite jeder Klasse bleibt exakt gleich.
# Precision verliert dabei am meisten (Lancer -50 %), Impact-Klassen bleiben
# ohne Upgrade unveraendert. Bots gleichen ihren Vorhalt aus, damit das Pacing
# nicht still verrutscht. Ohne den Schalter fliegen die Kugeln wie bisher.
PROJECTILE_SPEED_V2=true
# Der Dash faehrt, statt zu springen: dieselbe Strecke (189 px), aber ueber die
# 180 ms seiner Wirkdauer verteilt statt in einem einzigen Tick. Erst damit
# gibt es eine Bewegung, die der Client zeichnen kann - ohne den Schalter kommt
# dort nur eine Positionsaenderung zwischen zwei Snapshots an, und genau so
# sieht es aus. Nebeneffekt: Die Fahrt endet an Waenden, statt den Endpunkt zu
# nehmen. Standardmaessig aus - gehoert zusammen mit der Spur im Client an.
DASH_TRAVEL_ENABLED=true
# Der Rueckstoss des Repulse wird ueber seine Wirkdauer getragen, statt sofort
# von der Bewegungsintegration gefressen zu werden. Ohne den Schalter legt ein
# Getroffener gemessene 44 px zurueck und steht nach 200 ms wieder - ein
# Tankdurchmesser, bei 195 px Wirkradius und 12 s Abklingzeit, und weniger, als
# er in derselben Zeit zu Fuss geht. Mit dem Schalter ist es dieselbe
# Stossstaerke ueber die 260 ms Wirkdauer: rund 107 px auf 100 px Abstand, in
# acht Snapshots sichtbar. Der Getroffene behaelt dabei die Kontrolle (der Stoss
# addiert sich zur eigenen Bewegung), und die Strecke endet an Waenden.
# Standardmaessig aus: Das ist eine Verdopplung der Wirkung, also eine
# Balance-Entscheidung. Nur der exakte Wert "true" schaltet ein.
REPULSE_TRAVEL_ENABLED=false

# ── Rate-Limits und Missbrauchsschutz ────────────────────────────────────────
# Standardmäßig an. "false" schaltet alles ab (Verhalten wie vor dem Modul).
RATE_LIMITS_ENABLED=true
# Gleichzeitige WebSocket-Verbindungen je IP. Achtung bei Mobilfunk: Hinter
# Carrier-NAT teilen sich viele Fremde eine IPv4 – bei Beschwerden zuerst hier
# erhöhen und "abuse.rejectedConnections" in /health beobachten.
RATE_LIMIT_CONNECTIONS_PER_IP=5
# Beitritte je IP und Minute.
RATE_LIMIT_JOINS_PER_MINUTE=20
# Anfragen je IP und Minute auf /leaderboard und /profile (/health bleibt frei).
RATE_LIMIT_HTTP_PER_MINUTE=60
# Wie viele Proxy-Hops vor dem Server stehen. Railway = 1. Nur der Eintrag,
# den der eigene Proxy angehängt hat, ist vertrauenswürdig – 0 ignoriert
# x-forwarded-for komplett (direkt erreichbarer Server).
TRUST_PROXY_HOPS=1

# ── Telemetrie ───────────────────────────────────────────────────────────────
# Anonyme Balance-Telemetrie inkl. /metrics-Endpoint (true/false).
TELEMETRY_ENABLED=true
# Optionales Bearer-Token für /metrics. Leer = kein Schutz; setzen, sobald der
# Serverport außerhalb des internen Netzes erreichbar ist.
METRICS_TOKEN=

# ── Supabase-Persistenz (optional) ───────────────────────────────────────────
# Beide Variablen zusammen schalten Leaderboard und Run-Persistenz ein. Fehlt
# eine davon, läuft der Server exakt wie ohne Persistenz. Anleitung:
# docs/SUPABASE.md
SUPABASE_URL=
# GEHEIM: service_role- bzw. secret-Key. Niemals in den Client, niemals ins Repo.
SUPABASE_SERVICE_ROLE_KEY=
# Abstand, in dem gepufferte Runs geschrieben werden (500–120000 ms).
PERSISTENCE_FLUSH_MS=5000
# Cache-Fenster von GET /leaderboard (1000–600000 ms).
LEADERBOARD_CACHE_MS=30000
# Schreibintervall der Besuchszählung (1000–300000 ms). Sie sammelt Sitzungen
# im Speicher und schreibt sie gebündelt – seltener als Runs, weil ein Besuch
# nur beim Verlassen entsteht.
SESSIONS_FLUSH_MS=15000

# ── Admin-Portal (/admin) ────────────────────────────────────────────────────
# Wer das Portal sehen darf: Supabase-Konto-IDs, durch Komma getrennt.
#
# LEER HEISST: NIEMAND. Eine leere Liste ist eine geschlossene Tür, kein
# offenes Scheunentor – ohne Eintrag kommt auch der Projekteigner nicht hinein.
#
# Die eigene ID findet man, indem man sich auf /admin anmeldet: Die Seite zeigt
# sie dann samt Kopierknopf an. Voraussetzung ist AUTH_ENABLED=true (siehe
# unten) – ohne Login gibt es kein Konto, das man eintragen könnte.
#
# Zusätzlich nötig: Migration 0005 (supabase/migrations/applied/0005_sessions.sql).
# Ohne sie steht im Portal der Live-Teil, aber kein Verlauf.
ADMIN_USER_IDS=

# ── Google-Login (optional, Sprint B) ────────────────────────────────────────
# Schaltet die Prüfung von Supabase-Zugriffstokens ein. Braucht zusätzlich
# SUPABASE_URL. Ohne true ist der gesamte Login-Pfad aus; Gäste spielen immer.
# Einrichtung: docs/SUPABASE.md, Teil 2.
AUTH_ENABLED=false
# NUR für ältere Supabase-Projekte, die Tokens mit HS256 signieren. Neuere
# Projekte brauchen das nicht – dann wird über die JWKS des Projekts geprüft.
# Genauso geheim wie der Service-Role-Key.
SUPABASE_JWT_SECRET=

# ── Google-Login im Client (optional) ────────────────────────────────────────
# Nur beide zusammen schalten den Anmelde-Knopf auf dem Startscreen frei; fehlt
# eine davon, gibt es keinen Login-Pfad und alle spielen als Gast. Die Werte
# landen im ausgelieferten Bundle – deshalb ausschließlich der öffentliche
# anon-Key, niemals der Service-Role-Key.
# Werden zur BUILD-Zeit eingebacken: nach Änderung neu bauen, nicht nur neu starten.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Klassen 4.0 (Welle A): die zwei neuen Familien. Opt-out - false/0/off
# schaltet die Signature ab, die Klassen bleiben waehlbar und spielen dann
# ohne Tarnung bzw. Hitze.
# SIGNATURE_SPECTER_ENABLED=false
# SIGNATURE_TEMPEST_ENABLED=false
# Klassen 4.0 (Welle B): Perks - je Klasse ab L15 ein Alleinstellungsmerkmal.
# PERKS_ENABLED=false
# Klassen 4.1: die Familien SIEGE (Stellung) und AEGIS (Schild). Opt-out.
# SIGNATURE_SIEGE_ENABLED=false
# SIGNATURE_AEGIS_ENABLED=false
